import contextlib
import subprocess
import sys
import threading
sys.path.append(".")

from unittest.mock import MagicMock, patch

from testsupport import JoltTest
from jolt import tools
from jolt import utils
from jolt.error import JoltTimeoutError


class ToolsInternal(JoltTest):
    name = "int/tools"

    def process(self):
        process = MagicMock()
        process.pid = 123
        process.args = "command"
        process.returncode = 0
        process.stdin = MagicMock()
        process.stdout = MagicMock()
        process.stderr = MagicMock()
        return process

    @patch("jolt.config.get", return_value="3")
    def test_thread_count_configured(self, _):
        self.assertEqual(tools.Tools().thread_count(), 3)

    @patch("jolt.config.get", return_value="0")
    def test_thread_count_zero_is_cpu_count(self, _):
        t = tools.Tools()
        self.assertEqual(t.thread_count(), t.cpu_count())

    @patch("jolt.config.get", side_effect=lambda section, key, default=None, *args, **kwargs: default)
    def test_thread_count_env_zero_is_cpu_count(self, _):
        t = tools.Tools()
        with t.environ(JOLT_THREADS="0"):
            self.assertEqual(t.thread_count(), t.cpu_count())
        with t.environ(JOLT_THREADS=""):
            self.assertEqual(t.thread_count(), t.cpu_count())
        with t.environ(JOLT_THREADS="5"):
            self.assertEqual(t.thread_count(), 5)

    def test_reader_is_daemon(self):
        stream = MagicMock()
        stream.readline.side_effect = [b"output\n", b""]
        logbuf = []

        reader = tools.Reader(threading.current_thread(), stream, logbuf=logbuf)
        reader.join()

        self.assertTrue(reader.daemon)
        self.assertEqual(logbuf, [(reader, "output")])

    def test_reader_progress_lines(self):
        # Chunks split lines, and carriage returns redraw progress
        stream = MagicMock()
        stream.read1.side_effect = [
            b"Cloning into 'x'...\nReceiving objects:  50% (1/2)\rReceiv",
            b"ing objects: 100% (2/2), done.\nwarning: last\n",
            b"",
        ]
        progress = MagicMock(side_effect=lambda line: line.startswith("Receiving"))
        logbuf = []

        reader = tools.Reader(threading.current_thread(), stream, logbuf=logbuf, progress=progress)
        reader.join()

        self.assertEqual(
            [call.args[0] for call in progress.call_args_list],
            [
                "Cloning into 'x'...",
                "Receiving objects:  50% (1/2)",
                "Receiving objects: 100% (2/2), done.",
                "warning: last",
            ])
        self.assertEqual(logbuf, [(reader, "Cloning into 'x'..."), (reader, "warning: last")])

    def test_reader_progress_never_logs_redrawn_lines(self):
        stream = MagicMock()
        stream.read1.side_effect = [b"remote: Enumerating objects: 3\r", b"tail", b""]
        logbuf = []

        reader = tools.Reader(threading.current_thread(), stream, logbuf=logbuf, progress=lambda line: False)
        reader.join()

        self.assertEqual(logbuf, [(reader, "tail")])

    def configuration_stamp(self, builddir, configuration_hash):
        t = MagicMock()
        t._task = MagicMock()
        with patch("jolt.influence.configuration_hash", return_value=configuration_hash):
            return tools._ConfigurationStamp(t, builddir)

    @patch("jolt.config.getboolean", side_effect=lambda section, key, default=None: default)
    def test_configuration_stamp(self, _):
        with tools.Tools().tmpdir() as builddir:
            stamp = self.configuration_stamp(builddir, "a")
            self.assertTrue(stamp.is_outdated())
            stamp.update()
            self.assertFalse(self.configuration_stamp(builddir, "a").is_outdated())
            self.assertTrue(self.configuration_stamp(builddir, "b").is_outdated())

    @patch("jolt.config.getboolean", return_value=True)
    def test_configuration_stamp_always_outdated_when_fresh(self, _):
        with tools.Tools().tmpdir() as builddir:
            stamp = self.configuration_stamp(builddir, "a")
            stamp.update()
            self.assertTrue(self.configuration_stamp(builddir, "a").is_outdated())

    def test_configuration_stamp_without_task(self):
        t = MagicMock()
        t._task = None
        self.assertFalse(tools._ConfigurationStamp(t, "/nonexistent").is_outdated())

    def test_close_process_streams_skips_active_reader(self):
        process = self.process()
        reader = MagicMock()
        reader.stream = process.stdout
        reader.is_alive.return_value = True

        tools._close_process_streams(process, ((process.stdout, reader),))

        process.stdin.close.assert_called_once_with()
        process.stdout.close.assert_not_called()
        process.stderr.close.assert_called_once_with()

    @patch("jolt.tools.utils.delayed_interrupt", return_value=contextlib.nullcontext())
    @patch("jolt.tools._close_process_streams")
    @patch("jolt.tools._stop_process")
    def test_cleanup_interrupted_process_is_bounded(
            self, stop_process, close_streams, delayed_interrupt):
        process = self.process()
        stdout = MagicMock()
        stdout.stream = process.stdout
        stderr = MagicMock()
        stderr.stream = process.stderr

        tools._cleanup_interrupted_process(process, (stdout, stderr))

        stop_process.assert_called_once_with(process)
        stdout.join.assert_called_once_with(tools.READER_JOIN_TIMEOUT)
        stderr.join.assert_called_once_with(tools.READER_JOIN_TIMEOUT)
        close_streams.assert_called_once()
        delayed_interrupt.assert_called_once_with()

    @patch("jolt.tools.utils.delayed_interrupt", return_value=contextlib.nullcontext())
    @patch("jolt.tools._stop_process", side_effect=KeyboardInterrupt)
    def test_cleanup_interrupted_process_suppresses_second_interrupt(
            self, stop_process, delayed_interrupt):
        process = self.process()
        tools._cleanup_interrupted_process(process)

        stop_process.assert_called_once_with(process)

    @patch("jolt.tools._cleanup_interrupted_process")
    def test_wait_for_process_preserves_keyboard_interrupt(self, cleanup):
        process = self.process()
        process.wait.side_effect = KeyboardInterrupt

        with self.assertRaises(KeyboardInterrupt):
            tools._wait_for_process(process, 7)

        process.wait.assert_called_once_with(timeout=7)
        cleanup.assert_called_once_with(process)

    @patch("jolt.tools.utils.call_and_catch")
    @patch("jolt.tools._kill_process")
    @patch("jolt.tools._terminate_process")
    def test_stop_process_escalates_to_kill(
            self, terminate_process, kill_process, call_and_catch):
        process = self.process()
        process.wait.side_effect = subprocess.TimeoutExpired("command", 10)

        tools._stop_process(process)

        terminate_process.assert_called_once_with(process)
        process.wait.assert_called_once_with(10)
        kill_process.assert_called_once_with(process)
        call_and_catch.assert_called_once_with(process.wait, 10)

    @patch("jolt.tools._close_process_streams")
    @patch("jolt.tools._cleanup_interrupted_process")
    @patch("jolt.tools._wait_for_process", return_value=False)
    @patch("jolt.tools.Reader")
    @patch("jolt.tools.subprocess.Popen")
    def test_run_cleans_up_interrupt_during_reader_join(
            self, popen, reader_type, wait_for_process,
            cleanup, close_streams):
        process = self.process()
        popen.return_value = process
        stdout = MagicMock()
        stdout.stream = process.stdout
        stdout.join.side_effect = KeyboardInterrupt
        stderr = MagicMock()
        stderr.stream = process.stderr
        reader_type.side_effect = [stdout, stderr]

        with self.assertRaises(KeyboardInterrupt):
            tools._run("command", None, None)

        wait_for_process.assert_called_once_with(process, None)
        cleanup.assert_called_once_with(process, (stdout, stderr))
        close_streams.assert_called_once()
        stderr.join.assert_not_called()

    @patch("jolt.tools._close_process_streams")
    @patch("jolt.tools._wait_for_process", return_value=True)
    @patch("jolt.tools.Reader")
    @patch("jolt.tools.subprocess.Popen")
    def test_run_bounds_reader_join_after_timeout(
            self, popen, reader_type, wait_for_process, close_streams):
        process = self.process()
        process.returncode = -15
        popen.return_value = process
        stdout = MagicMock()
        stdout.stream = process.stdout
        stderr = MagicMock()
        stderr.stream = process.stderr
        reader_type.side_effect = [stdout, stderr]

        with self.assertRaises(JoltTimeoutError):
            tools._run("command", None, None, timeout=1)

        stdout.join.assert_called_once_with(tools.READER_JOIN_TIMEOUT)
        stderr.join.assert_called_once_with(tools.READER_JOIN_TIMEOUT)

    def test_run_timeout_with_blocked_output_callback(self):
        # The stderr reader's output callback never returns, as when it is
        # blocked on a logging lock held by another thread.
        blocked = threading.Event()
        release = threading.Event()

        def stderr_output(line, *args, **kwargs):
            blocked.set()
            release.wait(30)

        result = []

        def invoke():
            try:
                tools._run(
                    [sys.executable, "-c",
                     "import sys, time; "
                     "print('line', file=sys.stderr, flush=True); "
                     "time.sleep(30)"],
                    None,
                    None,
                    timeout=1,
                    shell=False)
            except BaseException as exc:
                result.append(exc)

        try:
            with patch("jolt.tools.log.stderr", stderr_output):
                worker = threading.Thread(target=invoke, daemon=True)
                worker.start()
                self.assertTrue(blocked.wait(10))
                worker.join(15)
            self.assertFalse(worker.is_alive())
        finally:
            release.set()

        self.assertEqual(len(result), 1)
        self.assertIsInstance(result[0], JoltTimeoutError)

    @patch("jolt.tools._close_process_streams")
    @patch("jolt.tools._wait_for_process", return_value=True)
    def test_popen_file_bounds_reader_join_after_timeout(
            self, wait_for_process, close_streams):
        process = self.process()
        process.returncode = -15
        options = {
            "timeout": 1,
            "output": False,
            "output_on_error": False,
            "output_rstrip": True,
            "output_stderr": False,
            "output_stdio": False,
        }

        with patch("jolt.tools.Reader") as reader_type:
            reader = reader_type.return_value
            reader.stream = process.stderr
            popen_file = tools._PopenFile(process, **options)

        with self.assertRaises(JoltTimeoutError):
            popen_file.finalize()

        reader.join.assert_called_once_with(tools.READER_JOIN_TIMEOUT)
        process.stdout.read.assert_not_called()

    @patch("jolt.tools._close_process_streams")
    @patch("jolt.tools._cleanup_interrupted_process")
    @patch("jolt.tools._wait_for_process", return_value=False)
    def test_popen_file_cleans_up_interrupt_during_reader_join(
            self, wait_for_process, cleanup, close_streams):
        process = self.process()
        options = {
            "timeout": None,
            "output": False,
            "output_on_error": False,
            "output_rstrip": True,
            "output_stderr": False,
            "output_stdio": False,
        }

        with patch("jolt.tools.Reader") as reader_type:
            reader = reader_type.return_value
            reader.stream = process.stderr
            reader.join.side_effect = KeyboardInterrupt
            process.stdout.read.return_value = b""
            popen_file = tools._PopenFile(process, **options)

        with self.assertRaises(KeyboardInterrupt):
            popen_file.finalize()

        cleanup.assert_called_once_with(process, (reader,))
        close_streams.assert_called_once()

    def test_run_defers_block_timeout(self):
        # The command ignores SIGTERM, so stopping it after its own timeout
        # takes a while. The block deadline expires meanwhile and must not
        # interrupt the cleanup and leave the command running.
        with self.assertRaises(JoltTimeoutError) as cm:
            with utils.timeout(1.5, JoltTimeoutError):
                tools._run(
                    [sys.executable, "-c",
                     "import signal, time; "
                     "signal.signal(signal.SIGTERM, signal.SIG_IGN); "
                     "time.sleep(30)"],
                    None,
                    None,
                    timeout=1,
                    shell=False)
        self.assertIn("Command timeout", str(cm.exception))
