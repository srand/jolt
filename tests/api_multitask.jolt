#!/usr/bin/env python

import os
import re
import sys
sys.path.append(".")

from testsupport import JoltTest


class MultiTaskApi(JoltTest):
    name = "api/multitask"

    def _require_jobserver_support(self):
        if os.name == "nt" or not hasattr(os, "mkfifo"):
            self.skipTest("jobserver FIFO helper is not supported on this platform")

    def test_input_declared_before_producer(self):
        """
        --- tasks:
        class Order(MultiTask):
            def generate(self, deps, tools):
                self.command("cat {{inputs}} > {{outputs}}", inputs=["out/gen.txt"], outputs=["out/use.txt"])
                self.command("echo gen > {{outputs}}", outputs=["out/gen.txt"])
        ---
        """
        self.build("order")
        self.assertContains("out/use.txt", "gen")

    def test_duplicate_output(self):
        """
        --- tasks:
        class Dup(MultiTask):
            def generate(self, deps, tools):
                self.command("echo a > {{outputs}}", outputs=["out/a.txt"])
                self.command("echo b > {{outputs}}", outputs=["out/a.txt"])
        ---
        """
        with self.assertRaises(Exception):
            self.build("dup")
        self.assertIn("'out/a.txt' is generated by both", self.lastLog())

    def test_render_file_kwargs(self):
        """
        --- file: value.tpl
        value={{{{ value }}}}

        --- tasks:
        @influence.files("value.tpl")
        class Tpl(MultiTask):
            def generate(self, deps, tools):
                self.render_file("value.tpl", outputs=["value.txt"], value="42")
        ---
        """
        self.build("tpl")
        self.assertContains("value.txt", "value=42")

    def test_render_creates_output_dirs(self):
        """
        --- file: value.tpl
        file

        --- tasks:
        @influence.files("value.tpl")
        class Tpl(MultiTask):
            def generate(self, deps, tools):
                self.render("string", outputs=["out/render/a.txt"])
                self.render_file("value.tpl", outputs=["out/render_file/b.txt"])
        ---
        """
        self.build("tpl")
        self.assertContains("out/render/a.txt", "string")
        self.assertContains("out/render_file/b.txt", "file")

    def test_render_file_single_template(self):
        """
        --- file: a.tpl
        a

        --- file: b.tpl
        b

        --- tasks:
        @influence.files("*.tpl")
        class Tpl(MultiTask):
            def generate(self, deps, tools):
                self.render_file(["a.tpl", "b.tpl"], outputs=["out.txt"])
        ---
        """
        with self.assertRaises(Exception):
            self.build("tpl")
        self.assertIn("Can only render one template at a time", self.lastLog())

    def test_input_influence_missing(self):
        """
        --- file: in.txt
        data

        --- tasks:
        class Base(MultiTask):
            abstract = True

            def generate(self, deps, tools):
                self.command("cp {{inputs}} {{outputs}}", inputs=["in.txt"], outputs=["out/in.txt"])

        class Copy(Base):
            pass

        @influence.files("in.txt")
        class Influenced(Base):
            pass
        ---
        """
        with self.assertRaises(Exception):
            self.build("copy")
        self.assertIn("Missing influence", self.lastLog())
        self.build("influenced")

    def test_modified_output_is_rebuilt(self):
        """
        --- file: trigger.txt
        1

        --- tasks:
        @influence.files("trigger.txt")
        class Gen(MultiTask):
            def generate(self, deps, tools):
                self.command("echo gen > {{outputs}}", outputs=["out/gen.txt"])
        ---
        """
        self.build("gen")
        # Rerun the task without --force, which would discard the incremental state
        with self.tools.cwd(self.ws):
            self.tools.write_file("out/gen.txt", "edited")
            self.tools.write_file("trigger.txt", "2")
        r = self.build("gen")
        self.assertRegex(r, r"\] echo gen > out/gen.txt")
        self.assertContains("out/gen.txt", "gen")

    def test_unmodified_output_is_not_rebuilt(self):
        """
        --- file: trigger.txt
        1

        --- tasks:
        @influence.files("trigger.txt")
        class Gen(MultiTask):
            def generate(self, deps, tools):
                self.command("echo gen > {{outputs}}", outputs=["out/gen.txt"])
        ---
        """
        self.build("gen")
        with self.tools.cwd(self.ws):
            self.tools.write_file("trigger.txt", "2")
        r = self.build("gen")
        self.assertIsNone(re.search(r"\] echo gen > out/gen.txt", r))

    def test_jobserver_limits_subtasks(self):
        """
        --- config:

        [jobserver]
        launch = true
        slots = 1
        path = .jobserver

        --- tasks:
        class Serial(MultiTask):
            def generate(self, deps, tools):
                for name in ["a", "b", "c", "d"]:
                    self.command(
                        "mkdir out/lock && sleep 0.3 && rmdir out/lock && touch {{outputs}}",
                        outputs=["out/" + name])
        ---
        """
        self._require_jobserver_support()
        self.build("serial")
        for name in ["a", "b", "c", "d"]:
            self.assertExists("out", name)
