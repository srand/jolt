#!/usr/bin/env python3

import fcntl
import os
import struct
import subprocess
import sys
import termios
import textwrap
import threading
import time

from jolt.utils import timeout
sys.path.append(".")

import jolt

from testsupport import JoltTest
from jolt.plugins.jobserver_main import find_jobserver
from jolt.plugins.jobserver_main import launch_jobserver
from jolt.plugins.jobserver_main import stat_is_fifo
from jolt.plugins.jobserver_pressure import PressureMonitor
from jolt.plugins.jobserver_pressure import parse_limits
from jolt.plugins.jobserver_pressure import TokenRamp


class JobserverExtension(JoltTest):
    name = "ext/jobserver"

    def setup(self, deps, tools):
        super().setup(deps, tools)
        self.tools.setenv("MAKEFLAGS", None)

    def _require_jobserver_support(self):
        if os.name == "nt" or not hasattr(os, "mkfifo"):
            self.skipTest("jobserver FIFO helper is not supported on this platform")

    def _wait_for(self, predicate, timeout=5, interval=0.05, message="condition not met"):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if predicate():
                return
            time.sleep(interval)
        self.fail(message)

    def _write_psi(self, psi_path, totals):
        """ Write fake /proc/pressure files with the given 'some' totals. """
        os.makedirs(psi_path, exist_ok=True)
        for resource in ("cpu", "io", "memory"):
            tmp_path = os.path.join(psi_path, resource + ".tmp")
            with open(tmp_path, "w") as stream:
                stream.write("some avg10=0.00 avg60=0.00 avg300=0.00 total={}\n".format(
                    totals.get(resource, 0)))
                stream.write("full avg10=0.00 avg60=0.00 avg300=0.00 total=0\n")
            os.replace(tmp_path, os.path.join(psi_path, resource))

    def _pending_tokens(self, fd):
        """ Number of tokens in the FIFO, without taking them. """
        return struct.unpack("i", fcntl.ioctl(fd, termios.FIONREAD, b"\0" * 4))[0]

    def _pid_exists(self, pid):
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        return True

    def test_launch_and_attach(self):
        self._require_jobserver_support()

        jobserver_path = os.path.join(self.ws, "jobserver-launch")
        jobserver = launch_jobserver(3, path=jobserver_path)

        try:
            self.assertTrue(stat_is_fifo(jobserver.fifo_path))
            self.assertEqual(
                jobserver.get_env()["MAKEFLAGS"],
                "--jobserver-auth=fifo:{}".format(jobserver.fifo_path),
            )

            attached = find_jobserver(path=jobserver_path)
            self.assertIsNotNone(attached)
            self.assertEqual(attached.fifo_path, jobserver.fifo_path)
            self.assertEqual(attached.get_env(), jobserver.get_env())
        finally:
            jobserver.cleanup()

        self.assertFalse(os.path.exists(jobserver.fifo_path))
        self.assertFalse(os.path.exists(jobserver_path))

    def test_launch_config_exports_makeflags(self):
        """
        --- config:

        [jobserver]
        launch = true
        slots = 2
        path = .jobserver

        --- tasks:
        class A(Task):
            def run(self, deps, tools):
                flags = tools.getenv("MAKEFLAGS")
                self.info("MAKEFLAGS={{}}".format(flags))
                tools.write_file("makeflags.txt", flags)
        ---
        """
        self._require_jobserver_support()

        result = self.build("a")

        self.assertBuild(result, "a")
        self.assertContains("makeflags.txt", "--jobserver-auth=fifo:")
        self.assertContains("makeflags.txt", "--jobserver-auth=fifo:.jobserver/jobserver_fifo")
        self._wait_for(
            lambda: not os.path.exists(os.path.join(self.ws, ".jobserver")),
            message="jobserver helper was not cleaned up after Jolt exited",
        )

    def test_helper_stops_when_parent_is_killed(self):
        self._require_jobserver_support()

        jobserver_path = os.path.join(self.ws, "jobserver-parent-death")
        helper_pid_path = os.path.join(self.ws, "jobserver-helper.pid")
        parent_script_path = os.path.join(self.ws, "jobserver_parent.py")
        repo_root = os.path.dirname(os.path.dirname(jolt.__file__))

        with open(parent_script_path, "w") as stream:
            stream.write(textwrap.dedent("""
                import os
                import sys
                import time

                sys.path.insert(0, {!r})

                from jolt.plugins.jobserver_main import launch_jobserver

                jobserver = launch_jobserver(2, path=sys.argv[1], new_session=False)
                with open(sys.argv[2], "w") as pid_file:
                    pid_file.write(str(jobserver.process.pid))
                print("READY", flush=True)
                while True:
                    time.sleep(1)
            """).format(repo_root))

        parent = subprocess.Popen(
            [sys.executable, parent_script_path, jobserver_path, helper_pid_path],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            cwd=self.ws,
        )

        try:
            ready_line = parent.stdout.readline().strip()
            self.assertEqual(ready_line, "READY")

            self._wait_for(
                lambda: os.path.exists(helper_pid_path),
                message="jobserver helper pid file was not written",
            )
            with open(helper_pid_path) as stream:
                helper_pid = int(stream.read().strip())

            fifo_path = os.path.join(jobserver_path, "jobserver_fifo")
            self._wait_for(
                lambda: os.path.exists(fifo_path),
                message="jobserver fifo was not created",
            )

            parent.kill()
            parent.wait(timeout=30)

            self._wait_for(
                lambda: not os.path.exists(fifo_path),
                timeout=30,
                message="jobserver fifo was not removed after the parent died",
            )
            self._wait_for(
                lambda: not self._pid_exists(helper_pid),
                timeout=30,
                message="jobserver helper is still running after the parent died",
            )
        finally:
            if parent.stdout is not None:
                parent.stdout.close()
            if parent.poll() is None:
                parent.kill()
                parent.wait(timeout=5)

    def test_slots_limit_parallel_workers(self):
        self._require_jobserver_support()

        slots = 3
        jobserver_path = os.path.join(self.ws, "jobserver-slots")
        jobserver = launch_jobserver(slots, path=jobserver_path)
        worker_script = textwrap.dedent("""
            import os
            import sys
            import time

            fifo_path, acquired_path, release_path, done_path = sys.argv[1:5]
            fd = os.open(fifo_path, os.O_RDWR)
            try:
                token = os.read(fd, 1)
                with open(acquired_path, "w") as stream:
                    stream.write("acquired")
                while not os.path.exists(release_path):
                    time.sleep(0.01)
                os.write(fd, token)
            finally:
                os.close(fd)

            with open(done_path, "w") as stream:
                stream.write("done")
        """)
        workers = []

        try:
            for index in range(slots):
                acquired_path = os.path.join(self.ws, "worker-{}.acquired".format(index))
                release_path = os.path.join(self.ws, "worker-{}.release".format(index))
                done_path = os.path.join(self.ws, "worker-{}.done".format(index))
                process = subprocess.Popen(
                    [
                        sys.executable,
                        "-c",
                        worker_script,
                        jobserver.fifo_path,
                        acquired_path,
                        release_path,
                        done_path,
                    ],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    cwd=self.ws,
                )
                workers.append((process, acquired_path, release_path, done_path))

            self._wait_for(
                lambda: sum(os.path.exists(acquired_path) for _, acquired_path, _, _ in workers) == slots - 1,
                message="expected only slots - 1 workers to acquire jobserver tokens immediately",
            )

            time.sleep(0.2)
            self.assertEqual(
                sum(os.path.exists(acquired_path) for _, acquired_path, _, _ in workers),
                slots - 1,
            )

            for _, acquired_path, release_path, _ in workers:
                if os.path.exists(acquired_path):
                    with open(release_path, "w"):
                        pass

            self._wait_for(
                lambda: sum(os.path.exists(acquired_path) for _, acquired_path, _, _ in workers) == slots,
                message="blocked worker never acquired a token after one was released",
            )

            for _, acquired_path, release_path, _ in workers:
                if os.path.exists(acquired_path) and not os.path.exists(release_path):
                    with open(release_path, "w"):
                        pass

            self._wait_for(
                lambda: all(os.path.exists(done_path) for _, _, _, done_path in workers),
                message="not all workers released their tokens and exited",
            )
        finally:
            for process, acquired_path, release_path, _ in workers:
                if os.path.exists(acquired_path) and not os.path.exists(release_path):
                    with open(release_path, "w"):
                        pass
                if process.poll() is None:
                    process.terminate()
                    try:
                        process.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        process.kill()
                        process.wait(timeout=5)
            jobserver.cleanup()

    def test_pressure_limits(self):
        self.assertEqual(parse_limits({"cpu": None, "io": "", "memory": "1000"}), {"memory": 1000.0})
        self.assertEqual(parse_limits({"io": 1, "memory": 1000000}), {"io": 1.0, "memory": 1000000.0})
        for limits in ({"memory": 0}, {"memory": 1000001}, {"memory": "abc"}, {"gpu": 1000}):
            with self.assertRaises(ValueError, msg=str(limits)):
                parse_limits(limits)

    def test_pressure_monitor(self):
        psi_path = os.path.join(self.ws, "psi")
        self._write_psi(psi_path, {})

        self.assertFalse(PressureMonitor({}, path=psi_path).start())
        self.assertFalse(PressureMonitor({"memory": 1000}, path=os.path.join(self.ws, "nopsi")).start())

        monitor = PressureMonitor({"cpu": 1000, "memory": 1000}, path=psi_path)
        self.assertTrue(monitor.start())

        # A second of memory stall in a fraction of a second exceeds the limit
        self._write_psi(psi_path, {"memory": 1000000})
        time.sleep(0.1)
        self.assertTrue(monitor.update())
        self.assertGreater(monitor.rates["memory"], 1000)
        self.assertEqual(monitor.rates["cpu"], 0)

        # No additional stall since the previous sample
        time.sleep(0.1)
        self.assertFalse(monitor.update())
        self.assertEqual(monitor.rates["memory"], 0)

    def test_token_ramp(self):
        # 100 tokens over 10 seconds, adjusted every second: 10 tokens per step
        ramp = TokenRamp(100, ramp_time=10, interval=1)
        self.assertEqual(ramp.available, 10)

        # Grows while all tokens are taken
        for expected in (20, 30, 40):
            self.assertEqual(ramp.update(ramp.available, True, False), expected)

        # Without demand, falls back to the tokens in use plus a step
        self.assertEqual(ramp.update(15, False, False), 25)

        # Pressure first holds at the tokens in use, then shrinks every second
        self.assertEqual(ramp.update(25, True, True), 25)
        self.assertEqual(ramp.update(24, True, True), 18)
        self.assertEqual(ramp.update(18, True, True), 13)

        # Never more than all tokens, nor less than none
        ramp = TokenRamp(4, ramp_time=0, interval=1)
        self.assertEqual(ramp.available, 4)
        self.assertEqual(ramp.update(4, True, False), 4)
        self.assertEqual(ramp.update(0, True, True), 0)
        self.assertEqual(ramp.update(0, True, True), 0)

    def test_pressure_ramps_up_tokens(self):
        """ Under pressure limits, tokens are handed out gradually while clients take them. """
        self._require_jobserver_support()

        psi_path = os.path.join(self.ws, "psi")
        self._write_psi(psi_path, {})
        jobserver = launch_jobserver(
            9,
            path=os.path.join(self.ws, "jobserver-ramp"),
            pressure={"memory": 1000},
            psi_path=psi_path,
            interval=0.1,
            ramp_time=2,
        )
        fd = os.open(jobserver.fifo_path, os.O_RDWR)
        held = []
        try:
            # 8 tokens over 2 seconds: none to start with
            self.assertLess(self._pending_tokens(fd), 8)
            started = time.monotonic()
            while len(held) < 8:
                self.assertLess(time.monotonic() - started, 10, "tokens were never all handed out")
                if self._pending_tokens(fd):
                    held.append(os.read(fd, 1))
                time.sleep(0.01)
            # All tokens took about the ramp time
            self.assertGreater(time.monotonic() - started, 1)
        finally:
            for token in held:
                os.write(fd, token)
            os.close(fd)
            jobserver.cleanup()

    def test_pressure_withholds_tokens(self):
        self._require_jobserver_support()

        psi_path = os.path.join(self.ws, "psi")
        self._write_psi(psi_path, {})
        jobserver = launch_jobserver(
            3,
            path=os.path.join(self.ws, "jobserver-pressure"),
            pressure={"memory": 1000},
            psi_path=psi_path,
            ramp_time=0,
        )
        stop = threading.Event()

        def stall():
            total = 0
            while not stop.wait(0.1):
                total += 1000000
                self._write_psi(psi_path, {"memory": total})

        staller = threading.Thread(target=stall, daemon=True)
        fd = os.open(jobserver.fifo_path, os.O_RDWR)

        try:
            self.assertEqual(self._pending_tokens(fd), 2)

            staller.start()
            self._wait_for(
                lambda: self._pending_tokens(fd) == 0,
                timeout=10,
                message="tokens were not withheld while under pressure",
            )
            time.sleep(1.5)
            self.assertEqual(self._pending_tokens(fd), 0)

            stop.set()
            staller.join()
            self._wait_for(
                lambda: self._pending_tokens(fd) == 2,
                timeout=10,
                message="tokens were not released when pressure dropped",
            )
        finally:
            stop.set()
            os.close(fd)
            jobserver.cleanup()

    def test_pressure_withholds_tokens_from_busy_clients(self):
        """ Tokens are withheld even if clients take them back as soon as they are returned. """
        self._require_jobserver_support()

        slots = 5
        psi_path = os.path.join(self.ws, "psi")
        held_path = os.path.join(self.ws, "held")
        stop_path = os.path.join(self.ws, "stop")
        os.makedirs(held_path)
        self._write_psi(psi_path, {})
        jobserver = launch_jobserver(
            slots,
            path=os.path.join(self.ws, "jobserver-busy"),
            pressure={"memory": 1000},
            psi_path=psi_path,
            ramp_time=0,
        )
        worker_script = textwrap.dedent("""
            import os
            import sys
            import time

            fifo_path, marker_path, stop_path = sys.argv[1:4]
            fd = os.open(fifo_path, os.O_RDWR)
            while not os.path.exists(stop_path):
                token = os.read(fd, 1)
                open(marker_path, "w").close()
                time.sleep(0.02)
                os.unlink(marker_path)
                os.write(fd, token)
        """)
        workers = [
            subprocess.Popen(
                [
                    sys.executable,
                    "-c",
                    worker_script,
                    jobserver.fifo_path,
                    os.path.join(held_path, str(index)),
                    stop_path,
                ],
                stdin=subprocess.DEVNULL,
                cwd=self.ws,
            )
            for index in range(2 * slots)
        ]
        stop = threading.Event()

        def stall():
            total = 0
            while not stop.wait(0.1):
                total += 1000000
                self._write_psi(psi_path, {"memory": total})

        staller = threading.Thread(target=stall, daemon=True)

        try:
            self._wait_for(
                lambda: len(os.listdir(held_path)) == slots - 1,
                timeout=10,
                message="workers never used all tokens",
            )

            staller.start()
            self._wait_for(
                lambda: len(os.listdir(held_path)) <= 1,
                timeout=20,
                interval=0.01,
                message="tokens were not withheld from busy clients while under pressure",
            )

            stop.set()
            staller.join()
            self._wait_for(
                lambda: len(os.listdir(held_path)) == slots - 1,
                timeout=10,
                interval=0.01,
                message="tokens were not released to busy clients when pressure dropped",
            )
        finally:
            stop.set()
            with open(stop_path, "w"):
                pass
            for process in workers:
                process.kill()
                process.wait(timeout=5)
            jobserver.cleanup()

    def test_launch_config_with_pressure_limits(self):
        """
        --- config:

        [jobserver]
        launch = true
        slots = 2
        pressure_max_cpu = 1000000
        pressure_max_io = 1000000
        pressure_max_memory = 1000000

        --- tasks:
        class A(Task):
            def run(self, deps, tools):
                tools.write_file("makeflags.txt", tools.getenv("MAKEFLAGS"))
        ---
        """
        self._require_jobserver_support()

        result = self.build("a")

        self.assertBuild(result, "a")
        self.assertContains("makeflags.txt", "--jobserver-auth=fifo:")

    def test_launch_config_rejects_invalid_pressure_limits(self):
        """
        --- config:

        [jobserver]
        launch = true
        pressure_max_memory = 0

        --- tasks:
        class A(Task):
            pass
        ---
        """
        self._require_jobserver_support()

        with self.assertRaises(Exception):
            self.build("a")
        self.assertIn("memory pressure limit must be between 1 and 1000000", self.lastLog())
