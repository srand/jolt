from contextlib import contextmanager
import sys
sys.path.append(".")

from unittest.mock import MagicMock, patch

import threading

from testsupport import JoltTest
from jolt import error
from jolt import fstree
from jolt import influence


class Static(object):
    value = 1


class InfluenceInternal(JoltTest):
    name = "int/influence"

    def provider(self, name, value, **attrs):
        attrs.setdefault("is_workspace_resource", False)
        provider = MagicMock(**attrs)
        provider.name = name
        provider.get_influence.return_value = value
        return provider

    def configuration_hash(self, *providers):
        task = MagicMock()
        task.influence = list(providers)
        with patch.object(influence.HashInfluenceRegistry.get(), "_providers", []):
            return influence.configuration_hash(task)

    def test_configuration_hash_ignores_sources(self):
        params = self.provider("Parameters", "a=1")
        self.assertEqual(
            self.configuration_hash(params),
            self.configuration_hash(
                params,
                self.provider("File", "changed"),
                self.provider("Git", "changed"),
                self.provider("Requirement", "changed: git", is_workspace_resource=True)))

    def test_configuration_hash_includes_configuration(self):
        before = self.configuration_hash(
            self.provider("Parameters", "a=1"),
            self.provider("Requirement", "1: zlib", is_workspace_resource=False))
        self.assertNotEqual(before, self.configuration_hash(
            self.provider("Parameters", "a=2"),
            self.provider("Requirement", "1: zlib", is_workspace_resource=False)))
        self.assertNotEqual(before, self.configuration_hash(
            self.provider("Parameters", "a=1"),
            self.provider("Requirement", "2: zlib", is_workspace_resource=False)))

    def test_configuration_hash_skips_sources_without_computing_them(self):
        source = self.provider("File", "files")
        self.configuration_hash(self.provider("Parameters", "a=1"), source)
        source.get_influence.assert_not_called()

    def strings(self, *providers):
        task = MagicMock()
        task.influence = list(providers)
        with patch.object(influence.HashInfluenceRegistry.get(), "_providers", []):
            return influence.HashInfluenceRegistry.get().get_strings(task)

    def test_function_influence_hashes_dict_items_in_order(self):
        def probe(task):
            return {"os": "linux", "cc": "gcc 15"}

        self.assertEqual(
            self.strings(influence.FunctionInfluence(probe)),
            ["Influence-Probe: cc=gcc 15", "Influence-Probe: os=linux"])

    def test_function_influence_is_called_with_the_task(self):
        def host_os(task):
            return task.os

        provider = influence.FunctionInfluence(host_os)
        task = MagicMock(os="darwin")
        self.assertEqual(provider.name, "HostOs")
        self.assertEqual(provider.get_influence(task), "darwin")

    def test_attribute_influence_expands_keywords(self):
        task = MagicMock(url=["https://example.com/tool-{system}.zip"])
        task.tools.expand.side_effect = lambda s: s.replace("{system}", "darwin")
        self.assertEqual(
            influence.TaskAttributeInfluence("url", expand=True).get_influence(task),
            ["https://example.com/tool-darwin.zip"])
        self.assertEqual(
            influence.TaskAttributeInfluence("url").get_influence(task),
            ["https://example.com/tool-{system}.zip"])

    def generated(self, name="Generated", value=1, bases=(object,), **attrs):
        def run(self, deps, tools):
            return value in {"x", "y", "z"}
        return type(name, bases, dict(value=value, run=run, **attrs))

    def generated_digest(self, cls):
        return influence._GeneratedClassDigest(cls).digest()

    def test_generated_class_is_detected(self):
        digests = influence._ClassSourceDigests
        self.assertFalse(digests._is_generated(Static))
        self.assertTrue(digests._is_generated(self.generated()))

    def test_generated_class_is_detected_by_missing_source_before_python_3_13(self):
        with patch.object(influence.sys, "version_info", (3, 12)):
            self.assertFalse(influence._ClassSourceDigests._is_generated(Static))
            self.assertTrue(influence._ClassSourceDigests._is_generated(self.generated()))

    def test_generated_class_with_name_of_static_class_is_detected(self):
        if sys.version_info < (3, 13):
            self.skipTest("requires Python 3.13")
        cls = self.generated("Static", bases=(Static,))
        self.assertTrue(influence._ClassSourceDigests._is_generated(cls))

    def test_generated_class_digest_is_deterministic(self):
        self.assertEqual(
            self.generated_digest(self.generated()),
            self.generated_digest(self.generated()))

    def test_generated_class_digest_includes_attributes_and_closures(self):
        digest = self.generated_digest(self.generated(value=1))
        self.assertNotEqual(digest, self.generated_digest(self.generated(value=2)))
        self.assertNotEqual(digest, self.generated_digest(self.generated(value=1, extra=[1])))
        self.assertNotEqual(digest, self.generated_digest(self.generated("Other", value=1)))

    def test_generated_class_digest_ignores_attributes_assigned_by_jolt(self):
        self.assertEqual(
            self.generated_digest(self.generated()),
            self.generated_digest(self.generated(joltdir="/ws", joltproject="p", taint="salt")))

    def test_generated_class_digest_rejects_nondeterministic_values(self):
        with self.assertRaises(error.JoltError):
            self.generated_digest(self.generated(lock=threading.Lock()))

    def test_generated_class_digest_is_not_stored(self):
        digests = influence._ClassSourceDigests()
        digests.get(self.generated())
        self.assertEqual(digests._new, [])
        self.assertIsNone(digests._db)

    @contextmanager
    def workspace_index(self):
        """ Replaces the index of the workspace with one that counts refreshes. """
        refresh = MagicMock(side_effect=lambda paths=None: MagicMock(excluded=["/ws/build"]))
        with patch.object(fstree, "_workspace_index", None), \
                patch.object(fstree, "_workspace_index_changes", set()), \
                patch.object(fstree, "_workspace_index_frozen", False), \
                patch.object(fstree, "_refresh_workspace_index", refresh):
            yield refresh

    def test_workspace_index_is_indexed_once(self):
        with self.workspace_index() as refresh:
            fstree.index_workspace()
            index = fstree.get_workspace_index()
            fstree.index_workspace()
            self.assertIs(fstree.get_workspace_index(), index)
            refresh.assert_called_once_with()

    def test_workspace_index_is_never_indexed_when_requested(self):
        with self.workspace_index() as refresh:
            with self.assertRaisesRegex(Exception, "has not been indexed"):
                fstree.get_workspace_index()
            refresh.assert_not_called()

    def test_workspace_index_refreshes_only_changed_paths(self):
        with self.workspace_index() as refresh:
            fstree.index_workspace()
            fstree.invalidate_workspace_index("/ws/repo/")
            fstree.invalidate_workspace_index("/ws/other")
            fstree.invalidate_workspace_index("/ws/build/out")
            fstree.update_workspace_index()
            refresh.assert_called_with(["/ws/other", "/ws/repo"])

            # Nothing changed since
            fstree.update_workspace_index()
            fstree.get_workspace_index()
            self.assertEqual(refresh.call_count, 2)

    def test_workspace_index_out_of_date_is_an_error(self):
        with self.workspace_index() as refresh:
            fstree.index_workspace()
            fstree.invalidate_workspace_index("/ws/repo")
            with self.assertRaisesRegex(Exception, "out of date.*/ws/repo"):
                fstree.get_workspace_index()
            self.assertEqual(refresh.call_count, 1)

    def test_workspace_index_is_not_updated_before_it_is_indexed(self):
        with self.workspace_index() as refresh:
            fstree.invalidate_workspace_index("/ws/repo")
            fstree.update_workspace_index()
            refresh.assert_not_called()

            fstree.index_workspace()
            fstree.get_workspace_index()
            refresh.assert_called_once_with()

    def test_frozen_workspace_index_is_never_refreshed(self):
        with self.workspace_index() as refresh:
            fstree.freeze_workspace_index()
            fstree.index_workspace()
            index = fstree.get_workspace_index()
            fstree.invalidate_workspace_index("/ws/repo")
            fstree.update_workspace_index()
            self.assertIs(fstree.get_workspace_index(), index)
            self.assertEqual(refresh.call_count, 1)
