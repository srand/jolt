import sys
import threading
from unittest import mock
sys.path.append(".")

import grpc

from testsupport import JoltTest
from jolt import common_pb2 as common_pb
from jolt.error import JoltError


class RpcError(grpc.RpcError):
    def code(self):
        return grpc.StatusCode.UNAVAILABLE

    def details(self):
        return "recvmsg:Connection reset by peer"


class BuildStream(object):
    """ A ScheduleBuild stream that ends, or fails with error, when released. """

    def __init__(self, error=None):
        self.error = error
        self.release = threading.Event()
        self.cancelled = threading.Event()

    def next(self):
        from jolt.plugins.remote_execution import scheduler_pb2 as scheduler_pb
        return scheduler_pb.BuildUpdate(status=common_pb.BuildStatus.BUILD_ACCEPTED, build_id="build")

    def __iter__(self):
        self.release.wait(5)
        if self.cancelled.is_set():
            raise RpcError()
        if self.error:
            raise self.error
        return iter([])

    def cancel(self):
        self.cancelled.set()
        self.release.set()


class SchedulerInternal(JoltTest):
    name = "int/scheduler"

    def _executor(self):
        from jolt.plugins import scheduler
        task = mock.MagicMock()
        task.extensions = []
        return scheduler.RemoteExecutor(mock.MagicMock(), mock.MagicMock(), task)

    def _update(self, status):
        from jolt.plugins.remote_execution import scheduler_pb2 as scheduler_pb
        return scheduler_pb.TaskUpdate(status=status)

    def test_task_stream_ended_without_result(self):
        executor = self._executor()
        response = iter([self._update(common_pb.TaskStatus.TASK_QUEUED)])
        with self.assertRaisesRegex(JoltError, "without a result"):
            executor.run_task(None, response)

    def test_task_stream_ended_with_result(self):
        executor = self._executor()
        response = iter([
            self._update(common_pb.TaskStatus.TASK_QUEUED),
            self._update(common_pb.TaskStatus.TASK_PASSED),
        ])
        executor.run_task(None, response)

    def _session(self):
        from jolt.plugins import scheduler
        session = scheduler.RemoteSession.__new__(scheduler.RemoteSession)
        session.factory = mock.MagicMock()
        session.exec = mock.MagicMock()
        session.channel = mock.MagicMock()
        session.lock = threading.Lock()
        session.build = None
        session.build_id = None
        session.aborted = False
        session.buildenv = common_pb.BuildEnvironment()
        session.priority = 0
        session.streams_lock = threading.Lock()
        session.task_streams = {}
        session.lost_builds = {}
        return session

    def test_build_not_registered_again_after_failed_cancel(self):
        from jolt.plugins import scheduler
        session = self._session()
        session.build = mock.MagicMock()
        session.build_id = "build"
        session.exec.CancelBuild.side_effect = RpcError()
        task = mock.Mock()
        session.add_task_stream(session.build, task)

        session.cancel()
        self.assertIsNone(session.build)
        task.cancel.assert_called_once()
        session.channel.close.assert_called_once()
        self.assertGreater(session.exec.CancelBuild.call_args.kwargs["timeout"], 0)

        executor = scheduler.RemoteExecutor(mock.MagicMock(), session, mock.MagicMock())
        executor.factory.is_aborted.return_value = False
        self.assertTrue(executor.is_aborted())
        with self.assertRaises(scheduler.TaskCancelledException):
            session.make_build_request()
        session.exec.ScheduleBuild.assert_not_called()

    def test_abort_during_build_registration(self):
        from jolt.plugins import scheduler
        session = self._session()
        stream = BuildStream()
        session.exec.ScheduleBuild.return_value = stream
        reply = stream.next()

        def accept_after_abort():
            session.cancel()
            return reply

        with mock.patch.object(stream, "next", side_effect=accept_after_abort):
            with self.assertRaises(scheduler.TaskCancelledException):
                session.make_build_request()

        self.assertTrue(stream.cancelled.is_set())
        self.assertIsNone(session.build)
        session.exec.CancelBuild.assert_not_called()
        session.channel.close.assert_called_once()

    def _lose_build(self, error):
        session = self._session()
        stream = BuildStream(error)
        session.exec.ScheduleBuild.return_value = stream
        build, build_id = session.make_build_request()
        self.assertIs(build, stream)
        self.assertEqual(build_id, "build")

        task = mock.MagicMock()
        session.add_task_stream(build, task)
        stream.release.set()

        for _ in range(100):
            if task.cancel.called:
                break
            threading.Event().wait(0.05)
        task.cancel.assert_called_once()
        self.assertIsNone(session.build)
        self.assertIn("Lost build build", session.lost_build_reason(build))

        late_task = mock.MagicMock()
        session.add_task_stream(build, late_task)
        late_task.cancel.assert_called_once()

    def test_build_stream_ended(self):
        self._lose_build(None)

    def test_build_stream_failed(self):
        self._lose_build(RpcError())

    def test_task_goaway_keeps_build_registration(self):
        class Goaway(RpcError):
            def details(self):
                return "GOAWAY received; Error code: 0; Debug Text: "

        session = self._session()
        build = BuildStream()
        session.exec.ScheduleBuild.return_value = build
        session.http_uri = "http://scheduler"
        executor = self._executor()
        executor.session = session
        executor.factory.is_aborted.return_value = False
        executor.task.identity = "task-id"
        executor.task.instance = "task"
        sibling = mock.Mock()
        failed_stream = mock.MagicMock()
        failed_stream.__iter__.side_effect = Goaway()
        retry_stream = iter([self._update(common_pb.TaskStatus.TASK_PASSED)])

        try:
            session.make_build_request()
            session.add_task_stream(build, sibling)
            session.exec.ScheduleTask.side_effect = [failed_stream, retry_stream]
            executor.run_build(None)

            self.assertEqual(session.exec.ScheduleTask.call_count, 2)
            session.exec.ScheduleBuild.assert_called_once()
            sibling.cancel.assert_not_called()
            self.assertIs(session.build, build)
            executor.task.finished_execution.assert_called_once_with(remote=True)
        finally:
            session.close()

    def test_cleared_build_cancels_task_streams(self):
        session = self._session()
        stream = BuildStream()
        session.exec.ScheduleBuild.return_value = stream
        build, _ = session.make_build_request()

        task = mock.MagicMock()
        session.add_task_stream(build, task)
        session.clear_build_request("Scheduler Error: connection lost", expected_build=build)

        task.cancel.assert_called_once()
        self.assertTrue(stream.cancelled.is_set())
        self.assertEqual(session.lost_build_reason(build), "Scheduler Error: connection lost")

        replacement = BuildStream()
        session.exec.ScheduleBuild.return_value = replacement
        new_build, _ = session.make_build_request()
        try:
            late_task = mock.Mock()
            session.add_task_stream(build, late_task)
            late_task.cancel.assert_called_once()

            new_task = mock.Mock()
            session.add_task_stream(new_build, new_task)
            session.clear_build_request("Stale scheduler error", expected_build=build)
            self.assertIs(session.build, new_build)
            self.assertFalse(replacement.cancelled.is_set())
            new_task.cancel.assert_not_called()
        finally:
            session.close()
