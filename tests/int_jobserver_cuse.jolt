import ctypes
import os
import stat
import sys
import threading
import time
from unittest import mock

sys.path.append(".")

from testsupport import JoltTest
from jolt.plugins import jobserver_cuse
from jolt.plugins.jobserver_cuse import FuseFileInfo, JobServer, POLLIN, POLLOUT


class JobserverCuseInternal(JoltTest):
    name = "int/jobserver/cuse"

    def server(self, tokens):
        # The FUSE library is replaced, the callbacks are called directly
        with mock.patch.object(JobServer, "_load_fuse", return_value=mock.MagicMock()):
            return JobServer(tokens=tokens)

    def poll(self, server, events, ph):
        fi = FuseFileInfo()
        fi.poll_events = events
        req = object()
        server.dev_poll(req, ctypes.pointer(fi), ph)
        return req

    def test_poll_without_handle_is_answered(self):
        """ A poll without a handle must still be answered, or the client blocks in the kernel. """
        server = self.server(tokens=0)
        req = self.poll(server, POLLIN, None)
        server.lib.fuse_reply_poll.assert_called_once_with(req, 0)
        self.assertEqual([], server.pollers)

    def test_poll_with_handle_is_queued(self):
        """ A poll with a handle is answered and woken when a token is returned. """
        server = self.server(tokens=0)
        req = self.poll(server, POLLIN, 1234)
        server.lib.fuse_reply_poll.assert_called_once_with(req, 0)
        self.assertEqual([jobserver_cuse.Poller(ph=1234)], server.pollers)

    def test_ramp_limits_tokens_handed_out(self):
        """ Under pressure limits, only the tokens that the ramp allows are handed out. """
        from jolt.plugins.jobserver_pressure import TokenRamp
        server = self.server(tokens=10)
        server.ramp = TokenRamp(10, ramp_time=10, interval=1)
        self.assertEqual(server.available(), 1)

        client = jobserver_cuse.Client(pid=1)
        server.clients[1] = client
        client.balance, server.tokens = 1, 9
        self.assertEqual(server.available(), 0)

        # A waiting client is demand, so the ramp grows by a step
        server.ramp.update(server.in_use(), True, False)
        self.assertEqual(server.available(), 1)

        # Without pressure regulation, all idle tokens may be handed out
        server.ramp = None
        self.assertEqual(server.available(), 9)

    def test_poll_with_tokens_is_readable(self):
        server = self.server(tokens=1)
        req = self.poll(server, POLLIN | POLLOUT, None)
        server.lib.fuse_reply_poll.assert_called_once_with(req, POLLIN | POLLOUT)
        self.assertEqual([], server.pollers)

    def test_device_node_made_accessible(self):
        """ The device node, created for root only, is made accessible to all users. """
        server = self.server(tokens=1)
        with self.tools.tmpdir("cuse") as tmp:
            path = os.path.join(tmp, "jobserver")
            os.close(os.open(path, os.O_CREAT | os.O_WRONLY, 0o600))
            server.make_accessible(path)
            self.assertEqual(0o666, stat.S_IMODE(os.stat(path).st_mode))

    def test_device_node_made_accessible_once_created(self):
        """ The node appears shortly after the device is registered. """
        server = self.server(tokens=1)
        with self.tools.tmpdir("cuse") as tmp:
            path = os.path.join(tmp, "jobserver")

            def create():
                time.sleep(0.2)
                os.close(os.open(path, os.O_CREAT | os.O_WRONLY, 0o600))

            creator = threading.Thread(target=create)
            creator.start()
            server.make_accessible(path, timeout=5)
            creator.join()
            self.assertEqual(0o666, stat.S_IMODE(os.stat(path).st_mode))

    def test_device_node_missing(self):
        server = self.server(tokens=1)
        with self.tools.tmpdir("cuse") as tmp:
            path = os.path.join(tmp, "jobserver")
            with mock.patch.object(server, "log") as log:
                server.make_accessible(path, timeout=0.2)
            self.assertFalse(os.path.exists(path))
            self.assertIn("did not appear", log.call_args[0][0])

    def test_init_done_makes_device_node_accessible(self):
        server = self.server(tokens=1)
        called = threading.Event()
        with mock.patch.object(server, "make_accessible", side_effect=lambda path: called.set()) as make:
            server.dev_init_done(None)
            self.assertTrue(called.wait(5))
        make.assert_called_once_with("/dev/jobserver")
