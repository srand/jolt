import contextlib
import glob
import os
import sys
from unittest import mock
sys.path.append(".")

from testsupport import JoltTest
from jolt import cli  # noqa: F401, imports jolt modules in dependency order
from jolt.plugins import selfdeploy


class Artifact(object):
    def __init__(self):
        self.files = set()

    def collect(self, pathname, *args, **kwargs):
        self.files.update(glob.glob(pathname, recursive=True))


class Tools(object):
    @contextlib.contextmanager
    def cwd(self, path):
        cwd = os.getcwd()
        os.chdir(path)
        try:
            yield
        finally:
            os.chdir(cwd)

    def builddir(self):
        return os.getcwd()


class Task(object):
    dependencies = []
    extra_files = []


class Distribution(object):
    def __init__(self, name, version, requires=None):
        self.name = name
        self.version = version
        self.requires = requires


def distributions(*dists):
    dists = {dist.name: dist for dist in dists}

    def distribution(name):
        try:
            return dists[name]
        except KeyError:
            raise selfdeploy.importlib_metadata.PackageNotFoundError(name)

    return mock.patch.object(selfdeploy.importlib_metadata, "distribution", distribution)


class SelfDeployInternal(JoltTest):
    name = "int/selfdeploy"

    def test_publish_collects_all_modules(self):
        artifact = Artifact()
        selfdeploy.Jolt.publish(Task(), artifact, Tools())

        with Tools().cwd(selfdeploy._path):
            modules = {
                path for path in glob.glob("jolt/**/*.py", recursive=True)
                if "__pycache__" not in path
            }
        self.assertEqual(modules - artifact.files, set())

    def test_dependencies_pin_requirements_of_jolt(self):
        with distributions(
            Distribution("jolt", "1.0", [
                "click>=8.1",
                "keyrings.alt",
                "zstandard; python_version < \"3.14\"",
                "conan>=2.0; extra == \"conan\"",
            ]),
            Distribution("click", "8.2.0", ["colorama; platform_system == \"Windows\""]),
            Distribution("keyrings.alt", "5.0"),
            Distribution("zstandard", "0.23.0"),
            Distribution("colorama", "0.4.6"),
            Distribution("conan", "2.1"),
        ):
            self.assertEqual(
                selfdeploy.resolve_dependencies(["jolt"]),
                [
                    "click==8.2.0",
                    "keyrings.alt==5.0",
                    "zstandard==0.23.0; python_version < \"3.14\"",
                ])

    def test_dependencies_keep_requirements_not_installed(self):
        with distributions(Distribution("jolt", "1.0", ["click>=8.1", "zstandard; python_version < \"3.14\""])):
            self.assertEqual(
                selfdeploy.resolve_dependencies(["jolt"]),
                ["click>=8.1", "zstandard; python_version < \"3.14\""])

    def test_dependencies_include_extra_requirements(self):
        with distributions(
            Distribution("jolt", "1.0", ["click"]),
            Distribution("click", "8.2.0"),
            Distribution("requests", "2.32.5", ["urllib3"]),
            Distribution("urllib3", "2.5.0"),
        ):
            self.assertEqual(
                selfdeploy.resolve_dependencies(["jolt", "requests", "allure-python-commons>=2"]),
                ["allure-python-commons>=2", "click==8.2.0", "requests==2.32.5"])
